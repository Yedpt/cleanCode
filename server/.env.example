# Ejemplo de variables de entorno para el servidor
# Copia este archivo a .env y reemplaza los valores por los reales.

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=mi_usuario
DB_PASSWORD=mi_contraseña
DB_DEV_NAME=cleancoders_dev
DB_TEST_NAME=cleancoders_test

# Entorno y puerto
NODE_ENV=development
PORT=4000

# Seguridad
JWT_SECRET=tu_secreto_jwt_aqui

# Frontend URL (para CORS)
FRONTEND_URL=http://localhost:5173

# Forzar sincronización de tablas (solo para entornos de desarrollo/test)
DB_SYNC_FORCE=false
